model$Size
#Compare actual species with cluster assignments
table(model$cluster. iris$Species)
#Compare actual species with cluster assignments
table(model$cluster, iris$Species)
#Convert cluster numbers to factor for plotting
iris$cluster <- as.factor(model$cluster)
